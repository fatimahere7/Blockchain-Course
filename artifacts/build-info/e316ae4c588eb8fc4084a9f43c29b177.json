				"content": "// SPDX-License-Identifier: MIT\r\npragma solidity ^0.8.19;\r\n\r\ncontract MyContract{\r\n    event addedData();\r\n    event deletedData();\r\n    struct MyData{\r\n        uint256 id;\r\n        string fname;\r\n        string lname;\r\n        uint256 age;\r\n        string designation;\r\n        string homeAddress;\r\n    }\r\n    mapping(address => MyData[]) mine;\r\n    function addNewData() public {\r\n\r\n        emit addedData();\r\n    }\r\n    function deleteData() public {\r\n\r\n        emit deletedData();\r\n    }\r\n    modifier onlyOwner(){\r\n\r\n        _;\r\n    }\r\n\r\n}"
